{
  "name": "umaxica-apps-edge-apex-dc",
  "dockerComposeFile": ["../compose.yaml", "./compose.override.yml"],
  "service": "apex",
  "remoteUser": "apex",
  "containerUser": "apex",
  "workspaceFolder": "/home/apex/workspace",
  "shutdownAction": "stopCompose",
  "runServices": ["apex"],
  "overrideCommand": false,
  "remoteEnv": {
    "EDITOR": "code --wait --reuse-window",
    "DEBUGGER_DISABLE": "1"
  },

  "forwardPorts": [5101, 5201, 5301, 5401],
  "portsAttributes": {
    "5101": {
      "label": "Com Apex",
      "onAutoForward": "notify"
    },
    "5201": {
      "label": "Net Apex",
      "onAutoForward": "notify"
    },
    "5301": {
      "label": "Org Apex",
      "onAutoForward": "notify"
    },
    "5401": {
      "label": "App Apex",
      "onAutoForward": "notify"
    }
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "openai.chatgpt",
        "anthropic.claude-code",
        "bradlc.vscode-tailwindcss",
        "github.vscode-github-actions",
        "GitHub.vscode-pull-request-github",
        "ms-azuretools.vscode-containers",
        "ms-azuretools.vscode-docker",
        "ms-vscode.remote-explorer",
        "GitHub.codespaces",
        "ms-vscode-remote.remote-containers",
        "nicolo-ribaudo.oxfmt-vscode",
        "nicolo-ribaudo.oxc-vscode",

        "-dbaeumer.vscode-eslint",
        "-esbenp.prettier-vscode",
        "-eamodio.gitlens",
        "-GitHub.copilot",
        "-GitHub.copilot-chat"
      ],
      "settings": {
        "claude.allowDangerouslySkipPermissions": true,
        "extensions.verifySignature": false,
        "editor.defaultFormatter": "nicolo-ribaudo.oxfmt-vscode",
        "editor.formatOnSave": true,
        "editor.tabSize": 2,
        "editor.codeActionsOnSave": {
          "source.fixAll": "explicit"
        },
        "files.trimTrailingWhitespace": true,
        "files.insertFinalNewline": true,
        "files.eol": "\n",
        "files.associations": {
          "compose.yaml": "yaml",
          "*.yml": "yaml"
        },
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          },
          "zsh": {
            "path": "/bin/zsh"
          }
        }
      }
    }
  },

  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/marcosbolanos/devcontainer-features/neovim-prebuilt:1": {},
    "ghcr.io/devcontainers/features/copilot-cli:1": {},
    "ghcr.io/stu-bell/devcontainer-features/gemini-cli:0": {},
    "ghcr.io/jsburckhardt/devcontainer-features/opencode:1": {},
    "ghcr.io/jasonthedeveloper/features/trivy:1": {},
    "ghcr.io/audacioustux/devcontainers/bun:1": {},
    "ghcr.io/jsburckhardt/devcontainer-features/codex:1": {},
    "ghcr.io/anthropics/devcontainer-features/claude-code:1": {}
  },
  "containerEnv": {
    "NODE_OPTIONS": "--max-old-space-size=4096"
  },
  "mounts": [
    "source=${localEnv:HOME}/.claude,target=/home/apex/.claude,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.claude.json,target=/home/apex/.claude.json,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.copilot,target=/home/apex/.copilot,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.codex,target=/home/apex/.codex,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gemini,target=/home/apex/.gemini,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/gh,target=/home/apex/.config/gh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/git,target=/home/apex/.config/git,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.gitconfig,target=/home/apex/.gitconfig,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.ssh,target=/home/apex/.ssh,type=bind,consistency=cached",
    "source=${localEnv:HOME}/.config/opencode,target=/home/apex/.config/opencode,type=bind,consistency=cached"
  ],
  "updateRemoteUserUID": true,
  "postCreateCommand": "sudo chown -R 1000:1000 /home/apex/"
}

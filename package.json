{
  "name": "umaxica-apps-edge-apex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build:apex:check": "XDG_CONFIG_HOME=${XDG_CONFIG_HOME:-/tmp} pnpm -r --filter ./app --filter ./com --filter ./net --filter ./org run build",
    "format": "pnpm exec oxfmt --write .",
    "formach:check": "pnpm exec oxfmt --check .",
    "lint": "pnpm exec oxlint --type-aware --type-check --fix .",
    "lint:check": "pnpm exec oxlint --type-aware --type-check .",
    "type": "pnpm -r --if-present --filter ./app --filter ./com --filter ./org --filter ./net run type",
    "typecheck": "pnpm run type",
    "test": "vp test run",
    "test:cov": "vp test run --coverage",
    "prepare": "vp config"
  },
  "dependencies": {
    "hono": "^4.12.23"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@types/node": "^25.9.1",
    "@typescript/native-preview": "7.0.0-dev.20260527.2",
    "@vitest/coverage-v8": "4.1.7",
    "happy-dom": "^20.9.0",
    "knip": "^6.14.2",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "wrangler": "^4.95.0"
  },
  "packageManager": "pnpm@10.29.3",
  "pnpm": {
    "overrides": {
      "minimatch": ">=10.2.3",
      "fast-xml-parser": "5.3.8",
      "ajv": ">=8.18.0"
    },
    "ignoredBuiltDependencies": [
      "@sentry/cli",
      "esbuild",
      "sharp",
      "workerd"
    ]
  }
}
